# Maintainer: Frank Hildebrandt

pkgname=justpaper
pkgver=0.3.2
pkgrel=1
pkgdesc="A frameless typewriter on a sheet of paper"
arch=('x86_64' 'aarch64')
url="https://github.com/frankhildebrandt/JustPaper"
license=('AGPL-3.0-only')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'librsvg')
makedepends=('cargo' 'nodejs' 'npm' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "justpaper.desktop")
sha256sums=('9886b4c57c197c5adbef5cebb4de3a1dd71409d7c65d9fa6de83a13c97798d7c'
            'b0e08326f9e76da7b00e3c4942aa895de5bbfc6091cd231edf4f1b3470a9f24c')

prepare() {
  cd "JustPaper-$pkgver"
  export CARGO_HOME="$srcdir/cargo"
  npm ci
}

build() {
  cd "JustPaper-$pkgver"
  export CARGO_HOME="$srcdir/cargo"
  npm run build
  cargo build --locked --release --manifest-path src-tauri/Cargo.toml
}

package() {
  cd "JustPaper-$pkgver"
  install -Dm755 src-tauri/target/release/justpaper "$pkgdir/usr/bin/justpaper"
  install -Dm644 "$srcdir/justpaper.desktop" "$pkgdir/usr/share/applications/justpaper.desktop"
  install -Dm644 src-tauri/icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/justpaper.png"
  install -Dm644 src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/justpaper.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
